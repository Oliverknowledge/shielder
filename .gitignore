.claude/skills/gstack/

# Rust / Anchor build output
/target/
substreams/target/
programs/shield-vault/target/
**/*.rs.bk

# Solana keypairs — never commit a real one; the deploy keypair here is
# throwaway/hackathon-only but still excluded on principle.
target/deploy/*-keypair.json

# Node / bun
node_modules/

# CRE: compiled artifacts (rebuildable via `bunx cre-compile`) and simulation secrets
cre/**/dist/
cre/.env

# Substreams compiled artifacts (rebuildable via cargo build --target wasm32-unknown-unknown)
substreams/**/*.wasm

# Web dashboard build output (rebuildable via `bun run build:app`)
app/dist/

# Misc
.DS_Store
*.log

# Local demo state and generated demo keys (never commit)
.shield/

# Foundry deps (run: cd contracts && forge install foundry-rs/forge-std --no-git)
contracts/lib/
contracts/out/
contracts/cache/
contracts/broadcast/

# EVM Substreams build artifacts
substreams-evm/target/
substreams-evm/src/abi_shield_vault.rs

# Local env files carry the Graph Market JWT and signing keys (never commit)
.env
.env.*
!.env.example
.substreams.env

# The built Substreams packages ARE committed. server/substreams-config.ts
# hardcodes these paths, and a judge cloning the repo has no way to produce
# them without the Rust wasm toolchain — so shipping the ~1.4 MB artefact is
# what makes the Graph integration reproducible at all.

# gstack installs per-project skills as symlinks into the author's home
# directory. Tracked, they are 96 dangling links in anyone else's clone that
# also publish a stranger's filesystem layout.
.claude/skills/

# The CRE CLI rewrites this ~900 KB bundle on every `cre workflow simulate`.
cre/shield-risk/.cre_build_tmp.js
