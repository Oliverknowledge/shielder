# ---------------------------------------------------------------------------
# Shield — environment. Copy to .env (never commit .env). Every value has a
# working localnet default; the ones marked "needs an account" are the only
# credentials the project uses, and each is a free-tier signup.
# ---------------------------------------------------------------------------

# Solana RPC the server, CLIs and scripts talk to.
#   localnet: http://127.0.0.1:8899   devnet: https://api.devnet.solana.com
SHIELD_RPC_URL=http://127.0.0.1:8899

# Where the app reaches the Shield server (behaviour + monitor). The app reads
# all enforcement state directly from the RPC below, never from the server.
VITE_SHIELD_RPC_URL=http://127.0.0.1:8899
VITE_SHIELD_API=http://localhost:8787
# Optional: pin the USDC mint the app offers during setup (defaults to the
# mint reported by the server's /api/health).
# VITE_USDC_MINT=

# Server
SHIELD_PORT=8787
SHIELD_STATE_DIR=.shield
SHIELD_POLL_MS=4000
SHIELD_MONITOR=1            # 0 disables signing/relaying verdicts
# SHIELD_DEMO=1             # demo endpoints (faucet, simulated returns); off automatically on mainnet
# SHIELD_AUTHORITY_KEYPAIR=~/.config/solana/id.json
# SHIELD_RISK_VERIFIER_KEYPAIR=.shield/risk-verifier.json
# SHIELD_RELAYER_KEYPAIR=.shield/relayer.json

# The Graph (needs an account: https://thegraph.market, free tier, no card).
# With a token the server streams the Substreams package from The Graph
# Market; without it, it falls back to Solana RPC and says so in /api/health.
#   substreams auth   (writes SUBSTREAMS_API_TOKEN to .substreams.env)
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=devnet.sol.streamingfast.io:443
SHIELD_SPKG=substreams/shield-behavioral-memory-v0.2.0.spkg
# First slot to index from on a fresh cursor (the vault's deployment slot).
SUBSTREAMS_START_SLOT=0

# Chainlink CRE (needs an account: https://app.chain.link -> API key).
# Required for `cre workflow simulate`; see cre/README.md.
CRE_API_KEY=
# Secrets consumed by the confidential workflow in simulation (cre/secrets.yaml):
SHIELD_VERIFIER_SEED_B64=      # base64 of the 32-byte Ed25519 seed the vault trusts
SHIELD_API_URL=http://localhost:8787
