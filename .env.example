# Copy to .env (gitignored). Never commit .env: it holds the Graph Market JWT
# and signing keys. Every variable below is read by code in this repo; the
# comment says what it does and whether it is required.
#
# "Required" means the process it belongs to fails or misbehaves without it.
# Everything else has a working default, shown in the comment.

# =====================================================================
# The Graph Market — Substreams (server + the `substreams` CLI)
# =====================================================================
SUBSTREAMS_API_TOKEN=               # required for any live Substreams run. Graph Market JWT (thegraph.market -> API key). One token, both stacks.
# SUBSTREAMS_SOLANA_API_TOKEN=      # optional: overrides the shared JWT for the Solana stack only
# SUBSTREAMS_HYPEREVM_API_TOKEN=    # optional: overrides the shared JWT for the HyperEVM stack only
SUBSTREAMS_SOLANA_ENDPOINT=devnet.sol.streamingfast.io:443          # optional (this is the default). Solana devnet, v0 stack.
SUBSTREAMS_HYPEREVM_ENDPOINT=hyperevm.substreams.pinax.network:443  # optional (this is the default). HyperEVM mainnet (999); The Graph has no HyperEVM testnet entry.
# SUBSTREAMS_ENDPOINT=              # optional, deprecated: legacy alias for SUBSTREAMS_SOLANA_ENDPOINT; warns when used
# SUBSTREAMS_SOLANA_SPKG=substreams/shield-behavioral-memory-v0.2.0.spkg          # optional: override the Solana package the server streams
# SUBSTREAMS_HYPEREVM_SPKG=substreams-evm/shield-evm-behavioral-memory-v0.1.0.spkg # optional: override the HyperEVM package
# SHIELD_SPKG=                      # optional, legacy alias for SUBSTREAMS_SOLANA_SPKG only (ignored on the EVM stack)
# SUBSTREAMS_START_SLOT=            # optional: Solana first slot to stream from (the vault's first tx). Default 0.
# SUBSTREAMS_BIN=                   # optional: path to the `substreams` CLI used by scripts/substreams-live.sh. Default: `which substreams`, else ~/.local/bin/substreams
# HYPEREVM_RPC_URL=                 # optional: RPC scripts/substreams-live.sh calls to find the mainnet head when no start block is given. Default https://rpc.hyperliquid.xyz/evm

# =====================================================================
# Shared server/CLI runtime (both chains)
# =====================================================================
# SHIELD_STATE_DIR=.shield          # optional: where demo state, cursors and generated keys live. Default .shield
SHIELD_PORT=8787                    # optional: HTTP port for whichever server you start. Default 8787. `bun run server:evm` overrides it to 8788 and `server:evm:anvil` to 8799, so the testnet and local stacks can run side by side.
# SHIELD_MONITOR=1                  # optional: run the in-process loss monitor that signs and relays verdicts. Default on for Anvil only; off on a real network, so the Chainlink enclave is the only signer. Set 1 to force it on.
# SHIELD_DEMO=                      # optional: expose the server's demo endpoints (/api/demo/*). Default on everywhere except HyperEVM mainnet (999) and Solana mainnet-beta.
# SHIELD_API=http://localhost:8787  # optional: the server URL client/demo.ts talks to. Default http://localhost:8787
# SHIELD_POLL_MS=                   # optional: indexer poll interval, ms. Default 15000 on HyperEVM (998/999), 4000 elsewhere.

# =====================================================================
# EVM / Hyperliquid stack — the live one
# =====================================================================
# Live deployment: ShieldVault.sol on HyperEVM testnet (chain 998) at
# 0xcdB6d631A00857584e70a21d800f51C5776302Fe, deployed in block 63561837.
EVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm   # required off Anvil. Anvil: http://127.0.0.1:8545; mainnet: https://rpc.hyperliquid.xyz/evm
EVM_CHAIN_ID=998                    # required: 998 testnet, 999 mainnet, 31337 Anvil. Default 31337.
EVM_START_BLOCK=63561837            # optional: first block the indexer reads (the vault's deploy block). Default: the demo-state file, else 0.
SHIELD_VAULT_ADDRESS=0xcdB6d631A00857584e70a21d800f51C5776302Fe   # required: the ShieldVault.sol deployment. Default: .shield/demo-state.evm.<network>.json
USDC_ADDRESS=0x2B3370eE501B4a559b57D449569354196457D8Ab           # required: the ERC-20 the vault holds (6dp). Circle test USDC on 998.
CORE_DEPOSIT_MOCK=                  # optional, Anvil only: address of the MOCK CoreDepositWallet the server's demo endpoints drive (settleLoss / withdrawToEvm). Leave empty on 998/999 — there the vault points at Circle's real one and there is nothing to mock.
# CORE_DEPOSIT_ADDRESS=             # optional, scripts/hyperevm-bootstrap.ts only: the REAL CoreDepositWallet the script asserts the deployed vault's coreDeposit() equals. Defaults per chain (998: 0x0B80659a4076E9E93C7DbE0f10675A16a3e5C206, 999: 0x6B9E773128f453f5c2C60935Ee2DE2CBc5390A24). Different variable, different job, from CORE_DEPOSIT_MOCK above.
EVM_DEPLOYER_KEY=                   # required by scripts/hyperevm-bootstrap.ts: funds the vault with gas and USDC. Never commit.
SHIELD_EVM_VERIFIER_KEY=            # required off Anvil: the monitor's signing key; its address must equal the vault's pinned riskVerifier. Same value as cre/.env. Never commit.
SHIELD_EVM_RELAYER_KEY=             # required off Anvil: pays gas to submit applyRiskVerdict. Never commit.
EVM_EXECUTION_KEY=                  # required off Anvil for the demo flows: the trading-venue stand-in wallet. Never commit.
# EVM_DEMO_KEY=                     # optional: the authority key client/evm-demo.ts signs as. Defaults to Anvil account 0; set it to the vault authority's key off Anvil.

# --- Public-RPC pacing. Defaults are network-aware; override only with a
# --- private endpoint. The public HyperEVM RPC caps eth_getLogs under ~200
# --- blocks and meters by request weight.
# EVM_RPC_GAP_MS=                   # optional: pause between eth_getLogs chunks, ms. Default 500 on HyperEVM, 0 elsewhere.
# EVM_MAX_BLOCKS_PER_POLL=          # optional: catch-up window per poll. Default 100 on HyperEVM, 10000000 elsewhere.
# EVM_LOG_CHUNK=                    # optional: blocks per eth_getLogs request. Default 50 on HyperEVM, 50000 elsewhere. Raise it to match EVM_LOG_INDEX_RPC_URL's limit.
EVM_LOG_INDEX_RPC_URL=              # optional but strongly recommended on 998/999: an endpoint used for HISTORICAL LOG READS ONLY. At 50 blocks a request a cold backfill takes about an hour; dRPC's free tier serves thousands of blocks a call and makes it seconds. Everything that signs or sends still uses EVM_RPC_URL, so the canonical endpoint stays the one of record.

# =====================================================================
# Bootstrap defaults — scripts/hyperevm-bootstrap.ts only
# =====================================================================
# All optional; each is read once when a vault is created. USD values, not raw.
# SHIELD_AUTHORITY_KEY=             # the key that OWNS the vault, as opposed to the one that funds it. `self` reuses EVM_DEPLOYER_KEY. Default: a key generated once into .shield/hyperevm-keys.json.
# SHIELD_AUTHORITY_GAS=0.2          # native-token floor the funder tops the authority up to, in HYPE. Default 0.2
# VENUE_ADDRESS=                    # the Hyperliquid account registered as the trading destination. Point it at one that actually trades so the app's venue panel reads live equity. Default: a generated key's address.
# SHIELD_FLOOR=6000                 # protected floor, USD. Nothing can ever release below it.
# SHIELD_DAILY=2000                 # rolling 24h release limit, USD.
# SHIELD_LOSS_TRIGGER=1000          # realised 24h loss, USD, at or above which a risk verdict is accepted.
# SHIELD_LOSS_COOLDOWN_HOURS=18     # how long the loss rule pauses new capital, hours.
# SHIELD_EMERGENCY_CAP=200          # largest instant transfer to a cold wallet, USD; above it waits.
# SHIELD_THRESHOLD_PCT=20           # a release of this % of balance or more takes the gated 30-minute path.

# =====================================================================
# Solana stack (v0). The local demo needs none of these.
# =====================================================================
SHIELD_RPC_URL=http://127.0.0.1:8899   # optional: Solana RPC. Default http://127.0.0.1:8899
# SHIELD_AUTHORITY_KEYPAIR=         # optional: path to the vault authority keypair JSON. Default ~/.config/solana/id.json
# SHIELD_RISK_VERIFIER_KEYPAIR=     # optional: path to the pinned risk-verifier keypair. Default $SHIELD_STATE_DIR/risk-verifier.json
# SHIELD_RELAYER_KEYPAIR=           # optional: path to the keypair that pays to submit verdicts. Default $SHIELD_STATE_DIR/relayer.json
# SHIELD_DEPOSIT_USDC=10000         # optional: opening deposit scripts/bootstrap-demo.ts makes, USD. Default 10000

# =====================================================================
# App (Vite). Read from this file via app/vite.config.mts `envDir`.
# =====================================================================
VITE_SHIELD_CHAIN=evm               # required: `evm` or `solana`. Picks the whole client engine.
VITE_SHIELD_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm   # required: the RPC the browser reads and signs against.
VITE_SHIELD_API=http://localhost:8788   # required: the Shield server. 8788 is the EVM server; the Solana one is 8787.
VITE_EVM_CHAIN_ID=998               # required on EVM: the chain the wallet must be on.
VITE_SHIELD_VAULT_ADDRESS=0xcdB6d631A00857584e70a21d800f51C5776302Fe   # optional: lets the app read the chain with the server down. Default: /api/health.
VITE_USDC_ADDRESS=0x2B3370eE501B4a559b57D449569354196457D8Ab           # optional: same, for the ERC-20. Default: /api/health.
# VITE_CORE_DEPOSIT_MOCK=           # optional, Anvil only: the mock CoreDepositWallet address so the app can show the HyperCore route locally. Default: /api/health.
# VITE_USDC_MINT=                   # optional, Solana only: USDC mint fallback when the server is unreachable.
VITE_HL_NETWORK=testnet             # optional: Hyperliquid network the venue panel reads. `testnet` or `mainnet`.
VITE_PRIVY_APP_ID=                  # required for the Privy sign-in (dashboard.privy.io -> app ID). Without it the app falls back to a pasted demo key, which is not the demo.

# =====================================================================
# Chainlink CRE
# =====================================================================
# CRE_API_KEY=                      # optional if you have run `cre login`; otherwise required by every `cre` command. See cre/README.md.
# The simulation's own environment is cre/.env — see cre/.env.example. It needs
# SHIELD_EVM_VERIFIER_KEY set to the same value as above.
