# ---- Solana stack (v0, local demo needs nothing) ----
SHIELD_RPC_URL=http://127.0.0.1:8899
SHIELD_PORT=8787
SUBSTREAMS_API_TOKEN=            # The Graph Market key (HUMAN_ACTIONS.md #3)
SUBSTREAMS_ENDPOINT=devnet.sol.streamingfast.io:443

# ---- EVM / Hyperliquid stack ----
EVM_RPC_URL=http://127.0.0.1:8545   # Anvil; HyperEVM testnet: https://rpc.hyperliquid-testnet.xyz/evm; mainnet: https://rpc.hyperliquid.xyz/evm
EVM_CHAIN_ID=31337                  # 998 testnet, 999 mainnet
SHIELD_VAULT_ADDRESS=               # ShieldVault.sol (or read from .shield/demo-state.evm.json)
USDC_ADDRESS=
CORE_DEPOSIT_MOCK=                  # Anvil only
SHIELD_EVM_VERIFIER_KEY=            # monitor signing key (never commit)
SHIELD_EVM_RELAYER_KEY=             # pays gas for applyRiskVerdict (never commit)

# ---- App (Vite) ----
VITE_SHIELD_CHAIN=solana            # or evm
VITE_SHIELD_RPC_URL=
VITE_SHIELD_API=http://localhost:8787
VITE_EVM_CHAIN_ID=31337
VITE_HL_NETWORK=testnet             # Hyperliquid network for the Trade screen
VITE_PRIVY_APP_ID=                  # HUMAN_ACTIONS.md #1

# ---- Chainlink CRE ----
CRE_API_KEY=                        # HUMAN_ACTIONS.md #4
