# Copy to .env (gitignored). Never commit .env: it holds the Graph Market JWT and signing keys.

# ---- The Graph Market (shared by both Substreams stacks and the `substreams` CLI) ----
SUBSTREAMS_API_TOKEN=               # Graph Market JWT (HUMAN_ACTIONS.md #3). One token, both stacks.
# SUBSTREAMS_SOLANA_API_TOKEN=      # optional: override the shared JWT for the Solana stack only
# SUBSTREAMS_HYPEREVM_API_TOKEN=    # optional: override the shared JWT for the HyperEVM stack only
SUBSTREAMS_SOLANA_ENDPOINT=devnet.sol.streamingfast.io:443          # Solana devnet (v0 stack)
SUBSTREAMS_HYPEREVM_ENDPOINT=hyperevm.substreams.pinax.network:443  # HyperEVM mainnet (chain 999); The Graph has no HyperEVM testnet
# SUBSTREAMS_SOLANA_SPKG=substreams/shield-behavioral-memory-v0.2.0.spkg
# SUBSTREAMS_HYPEREVM_SPKG=substreams-evm/shield-evm-behavioral-memory-v0.1.0.spkg
# SUBSTREAMS_START_SLOT=            # Solana: first slot to stream from (vault's first tx)

# ---- Solana stack (v0, local demo needs nothing) ----
SHIELD_RPC_URL=http://127.0.0.1:8899
SHIELD_PORT=8787

# ---- EVM / Hyperliquid stack ----
# Live deployment: ShieldVault.sol on HyperEVM testnet (chain 998) at
# 0xcdB6d631A00857584e70a21d800f51C5776302Fe, deployed in block 63561837.
EVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm   # Anvil: http://127.0.0.1:8545; mainnet: https://rpc.hyperliquid.xyz/evm
EVM_CHAIN_ID=998                    # 998 testnet, 999 mainnet, 31337 Anvil
EVM_START_BLOCK=63561837            # vault deploy block (also the Substreams start block on mainnet)
SHIELD_VAULT_ADDRESS=0xcdB6d631A00857584e70a21d800f51C5776302Fe   # ShieldVault.sol (or read from .shield/demo-state.evm.json)
USDC_ADDRESS=0x2B3370eE501B4a559b57D449569354196457D8Ab           # Circle test USDC on HyperEVM testnet (6dp)
CORE_DEPOSIT_MOCK=                  # Anvil only; on 998/999 the vault holds Circle's real CoreDepositWallet
EVM_DEPLOYER_KEY=                   # vault authority + deploy key (never commit)
SHIELD_EVM_VERIFIER_KEY=            # monitor signing key (never commit)
SHIELD_EVM_RELAYER_KEY=             # pays gas for applyRiskVerdict (never commit)
EVM_EXECUTION_KEY=                  # demo trading wallet (never commit)
# EVM_DEMO_KEY=                     # client/evm-demo.ts signs as the authority; set it to EVM_DEPLOYER_KEY off Anvil
# Public-RPC pacing (defaults are network-aware; override only if you have a private RPC)
# SHIELD_POLL_MS=                   # indexer poll interval (15000 on HyperEVM, 4000 elsewhere)
# EVM_RPC_GAP_MS=                   # pause between eth_getLogs chunks (500 on HyperEVM)
# EVM_MAX_BLOCKS_PER_POLL=          # catch-up window per poll (100 on HyperEVM)

# ---- App (Vite; read from this file via app/vite.config.mts envDir) ----
VITE_SHIELD_CHAIN=evm               # or solana
VITE_SHIELD_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
VITE_SHIELD_API=http://localhost:8788   # the EVM server; the Solana one is on 8787
VITE_EVM_CHAIN_ID=998
VITE_SHIELD_VAULT_ADDRESS=0xcdB6d631A00857584e70a21d800f51C5776302Fe   # lets the app read the chain without the server
VITE_USDC_ADDRESS=0x2B3370eE501B4a559b57D449569354196457D8Ab
VITE_HL_NETWORK=testnet             # Hyperliquid network for the Trade screen
VITE_PRIVY_APP_ID=                  # HUMAN_ACTIONS.md #1

# ---- Chainlink CRE ----
CRE_API_KEY=                        # HUMAN_ACTIONS.md #4
