{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun-types", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["client/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "cre/shield-risk/evaluate.ts", "cre/shield-risk/dryrun.ts"]
}
